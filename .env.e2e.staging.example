# Railway Staging E2E - local configuration TEMPLATE (committed; placeholders only).
#
# One-time setup:
#   1. Copy this file to .env.e2e.staging.local in the repository root
#      (PowerShell: Copy-Item .env.e2e.staging.example .env.e2e.staging.local).
#      .env.e2e.staging.local is gitignored - never commit it, never paste it in chats or tickets.
#   2. Fill in the values below. No quotes are needed around values.
#   3. Run: npm run e2e:staging:check
#
# Read only by `npm run e2e:staging:check` and the Staging phase runner. Values
# already set in your shell take precedence (the check warns when they differ).
# Only the keys below are accepted - database URLs, Stripe/Supabase keys and
# other server-side settings are refused, and so are per-run confirmations.

# Always "staging".
TEST_ENV=staging

# The approved Railway Staging URL - the only value accepted.
BASE_URL=https://tennisconnect-staging.up.railway.app

# Same value as E2E_TEST_HOOK_SECRET in the Railway STAGING service variables
# (at least 32 characters). Never the Production value - Production has no test hooks.
E2E_TEST_HOOK_SECRET=REPLACE_WITH_STAGING_SECRET

# Full 40-character commit Staging should be running. Railway Staging deploys `main`:
#   git fetch origin && git rev-parse origin/main
# Update it after each merge to main (the check tells you when it no longer matches).
EXPECTED_DEPLOY_SHA=replace-with-the-full-40-character-commit-sha

# Optional - also require Stripe test mode + webhook secret (payment tests).
# E2E_REQUIRE_PAYMENTS=1

# Optional - also verify Staging's storage host (upload tests). Hostnames only, never keys.
# E2E_REQUIRE_UPLOADS=1
# STAGING_SUPABASE_HOST=
# PRODUCTION_SUPABASE_HOST=

# Optional - per-request timeout for the check, in ms (1000-60000, default 10000).
# E2E_STAGING_CHECK_TIMEOUT_MS=10000
