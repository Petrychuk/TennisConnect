From dd101e780c45df9893549cc47b057650803b691c Mon Sep 17 00:00:00 2001
From: TennisConnect Dev <dev@tennisconnect.local>
Date: Thu, 13 Aug 2026 06:18:23 +0000
Subject: [PATCH] fix(icons): redraw ThreadsIcon as a bold @ glyph - hand-drawn
 path didn't look like the real mark

Rendered and visually compared a few approaches locally (headless
Chrome screenshot) since the last version was never actually checked
against the real logo. Hand-drawn bezier/arc paths kept coming out
wrong; a bold Arial/Helvetica '@' glyph is clean and reads correctly
as the Threads mark at both the 32px footer size and the 16px
maintenance-page size. Colour still comes from the parent's
currentColor, same as the other footer icons - no other changes.
---
 client/src/components/icons/ThreadsIcon.tsx | 22 +++++++++++++++++----
 1 file changed, 18 insertions(+), 4 deletions(-)

diff --git a/client/src/components/icons/ThreadsIcon.tsx b/client/src/components/icons/ThreadsIcon.tsx
index 81848f1..76457cd 100644
--- a/client/src/components/icons/ThreadsIcon.tsx
+++ b/client/src/components/icons/ThreadsIcon.tsx
@@ -1,17 +1,31 @@
 import type { SVGProps } from "react";
 
-// Same situation as TikTokIcon - Threads' logomark isn't part of
-// lucide-react's generic icon set, so this is a small stand-in path.
+// Threads' logomark is a stylised "@" - rendering it as a bold glyph
+// gets much closer to the real mark than a hand-drawn path (tried that
+// first; this sandbox has no way to preview bezier curves against the
+// real logo, so freehand tracing kept coming out wrong). Colour is
+// controlled the same way as the other footer icons, via `currentColor`
+// on the wrapping element - "the black bits" from the reference badge
+// become the brand colour, same as Facebook/Instagram/TikTok here.
 export function ThreadsIcon(props: SVGProps<SVGSVGElement>) {
   return (
     <svg
       viewBox="0 0 24 24"
-      fill="currentColor"
       xmlns="http://www.w3.org/2000/svg"
       aria-hidden="true"
       {...props}
     >
-      <path d="M12.2 2C7.1 2 3.4 4.8 3.1 9.9c-.02.4.29.75.7.75.36 0 .66-.27.69-.63C4.8 6.15 7.7 3.9 12.2 3.9c4.6 0 7.4 2.36 7.4 6.6 0 3.02-1.28 4.9-3.1 5.86-.2-1.6-1.02-2.9-2.36-3.7a5.6 5.6 0 0 0-2.9-.78c-2.24 0-4.04 1.3-4.04 3.24 0 1.98 1.66 3.28 4.02 3.28 1.9 0 3.36-.8 4.24-2.2.3.24.56.53.76.87-.98 1.5-2.74 2.35-5 2.35-3.36 0-5.9-1.98-5.9-5.4 0-1.9.86-3.4 2.3-4.3-1.06-.86-1.66-2.1-1.66-3.6C6.66 3.5 8.9 2 12.2 2Zm-.14 9.36c-1.4 0-2.3.66-2.3 1.6 0 .9.9 1.5 2.2 1.5 1.5 0 2.6-.68 2.94-2.02a4.2 4.2 0 0 0-2.84-1.08Z" />
+      <text
+        x="12"
+        y="17.5"
+        fontSize="19"
+        textAnchor="middle"
+        fontFamily="Arial, Helvetica, sans-serif"
+        fontWeight="800"
+        fill="currentColor"
+      >
+        @
+      </text>
     </svg>
   );
 }
-- 
